# Set both values to create or recover accounts on your local copy.
# SMTP_PASS is an app password for the Gmail address in SMTP_USER.
SMTP_USER=
SMTP_PASS=

# Optional shared AI key. Users can also add a personal key in Settings.
GEMINI_API_KEY=

# Optional 64-character hex secret for email-only workspace recovery.
PADHAI_RECOVERY_SECRET=

# Local defaults use SQLite and the Vite address below.
DATABASE_URL=
PADHAI_PUBLIC_URL=http://127.0.0.1:4173

# Optional relay for calls when a direct WebRTC connection is blocked.
# TURN_URLS is a comma-separated list of turn: or turns: addresses.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
