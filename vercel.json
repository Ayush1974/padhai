{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/wisdom/prepare",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://kmeet.infomaniak.com\"), microphone=(self \"https://kmeet.infomaniak.com\"), display-capture=(self \"https://kmeet.infomaniak.com\"), screen-wake-lock=(self \"https://kmeet.infomaniak.com\"), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=:path*"
    }
  ]
}
